# MEDUSA-X Backend Environment — copy to .env and fill in values

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Database
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/medusa_x

# JWT
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# OTP
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMS Gateway — set MOCK_OTP=true for local development (OTP printed to console)
MOCK_OTP=true

# Twilio (used when MOCK_OTP=false)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Indian SMS alternative (MSG91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=MEDUSA
MSG91_TEMPLATE_ID=

# File uploads
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=25
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,webp,tif,tiff,svg,txt,csv,json,doc,docx
